# URL de la API. Para Expo Go en un dispositivo físico usa la IP local del PC
# (ipconfig → IPv4 de tu Ethernet/Wi-Fi), no localhost.
# Puerto 8001: el 8000 lo puede ocupar otro servicio local.
EXPO_PUBLIC_API_URL=http://192.168.1.71:8001

# API key de Google Maps (solo necesaria para la development build de Android).
# Google Cloud Console → habilitar "Maps SDK for Android" → crear API key.
GOOGLE_MAPS_API_KEY=
